{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventAggregation",
  "type": "object",
  "required": ["window_start", "window_end", "event_type", "region", "source_system", "event_count"],
  "properties": {
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string"},
    "region": {"type": "string"},
    "source_system": {"type": "string"},
    "event_count": {"type": "integer"},
    "average_event_value": {"type": ["number", "null"]},
    "error_event_count": {"type": "integer"},
    "unique_device_count": {"type": "integer"}
  }
}
